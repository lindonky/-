menu "ESC Control"

    config ESC_CALIBRATE_ON_BOOT
        bool "Run ESC calibration sequence on boot"
        default y
        help
            On boot all channels hold 2200us for CAL_HIGH_TIME then the stop
            pulse for CAL_STOP_TIME, so the ESCs arm and beep. Disable after
            the ESCs are calibrated.

    config ESC_CALIB_HIGH_TIME_MS
        int "Calibration high pulse hold time (ms)"
        default 3000
        range 3000 10000

    config ESC_CALIB_STOP_TIME_MS
        int "Calibration stop pulse hold time (ms)"
        default 3000
        range 3000 10000

    config ESC_STOP_PULSE_US
        int "Stop pulse width (us)"
        default 1500
        range 800 2200
        help
            Center / stop pulse. 1500us for most ESCs; if arming fails try 1480us.

    config ESC_RAMP_STEP_US
        int "Speed ramp step (us per step)"
        default 50
        range 10 200
        help
            PWM is changed in small steps toward the target so the motor never
            jumps across the center instantly (protects the ESC when reversing).

    config ESC_RAMP_INTERVAL_MS
        int "Speed ramp step interval (ms)"
        default 100
        range 10 1000

    config ESC_BIDIRECTIONAL
        bool "Allow reverse (bidirectional ESCs)"
        default n
        help
            Enable when the ESCs are successfully initialized in bidirectional
            mode (negative speed = reverse). NOTE: the current ESC hardware only
            runs forward (reverse calibration does not take), so negative
            speeds are clamped to 0 while this is disabled.

    config STAB_ENABLE_ON_BOOT
        bool "Enable attitude stabilization on boot"
        default n

    config STAB_PERIOD_MS
        int "Stabilization control loop period (ms)"
        default 10
        range 5 50

    config STAB_STALE_TIMEOUT_MS
        int "IMU data stale timeout (ms)"
        default 200
        range 50 1000
        help
            Stop output if no valid JY61P frame within this time.

    config STAB_KP
        int "Angle error gain (output per degree)"
        default 20
        range 1 100

    config STAB_KD
        int "Gyro damping gain"
        default 5
        range 0 50

    config STAB_DEADBAND_DEG
        int "Deadband (deg): leg rests inside this range"
        default 3
        range 0 30

    config STAB_MAX_ANGLE_DEG
        int "Max deviation (deg): stop output beyond this"
        default 30
        range 5 90

    config STAB_MAX_OUTPUT
        int "Max control output (0-1000)"
        default 800
        range 100 1000

    config MODE_ASSIST_MAX
        int "Assist mode max output (0-1000)"
        default 800
        range 100 1000
        help
            Assist (support) mode: attitude stabilization output upper limit.

    config MODE_ACTIVE_MAX
        int "Active mode max output (0-1000)"
        default 1000
        range 100 1000
        help
            Active mode left/right correction output upper limit. The middle
            propulsion thruster always remains neutral in active mode.

    config MODE_IMPEDANCE_MAX
        int "Impedance mode max output (0-1000)"
        default 600
        range 100 1000
        help
            Impedance mode: reverses propulsion when the leg lifts
            (requires bidirectional ESCs; single-direction ESCs just slow
            to a stop). Output upper limit for both reverse and rudders.

    menu "Single-leg training metrics (engineering defaults)"

        config TRAIN_LIFT_START_DEG
            int "Lift detection threshold (shank deg)"
            default 8
            range 3 30

        config TRAIN_ROM_MIN_DEG
            int "Qualified shank ROM minimum (deg)"
            default 15
            range 5 60

        config TRAIN_ROM_MAX_DEG
            int "Qualified shank ROM maximum (deg)"
            default 45
            range 10 80

        config TRAIN_ROM_LIMIT_DEG
            int "Reject cycle beyond shank ROM (deg)"
            default 60
            range 20 90

        config TRAIN_SPEED_MIN_DPS
            int "Qualified mean angular speed minimum (deg/s)"
            default 10
            range 1 100

        config TRAIN_SPEED_MAX_DPS
            int "Qualified mean angular speed maximum (deg/s)"
            default 90
            range 20 300

        config TRAIN_CYCLE_MIN_MS
            int "Qualified cycle minimum time (ms)"
            default 800
            range 300 5000

        config TRAIN_CYCLE_MAX_MS
            int "Cycle timeout / qualified maximum time (ms)"
            default 8000
            range 2000 30000

        config TRAIN_LATERAL_MAX_DEG
            int "Qualified lateral shank deviation maximum (deg)"
            default 8
            range 2 30

        config TRAIN_RETURN_WINDOW_DEG
            int "Return-to-neutral window (deg)"
            default 5
            range 2 15

        config TRAIN_FALL_ANGLE_DEG
            int "Fall angle threshold relative to session start (deg)"
            default 65
            range 35 85
            help
                Latch emergency stop when either relative pitch or roll stays
                beyond this angle for TRAIN_FALL_ANGLE_HOLD_MS. This threshold
                must remain above TRAIN_ROM_LIMIT_DEG or the build will fail.

        config TRAIN_FALL_ANGLE_HOLD_MS
            int "Fall angle confirmation time (ms)"
            default 400
            range 100 2000

        config TRAIN_FALL_ACCEL_LOW_MG
            int "Free-fall acceleration threshold (milli-g)"
            default 550
            range 100 900
            help
                A resultant acceleration at or below this value immediately
                latches emergency stop while a training session is running.

        config TRAIN_FALL_ACCEL_HIGH_MG
            int "Impact acceleration threshold (milli-g)"
            default 1600
            range 1100 4000
            help
                A resultant acceleration at or above this value immediately
                latches emergency stop while a training session is running.

    endmenu

    config CAPTURE_MAX_SAMPLES
        int "Calibration capture sample capacity"
        default 1200
        range 200 3000
        help
            Number of valid IMU samples kept in RAM for a temporary calibration
            capture. At the usual JY61P UART output rate this is tens of seconds.
            Captures are never written to flash and are lost on reboot.

    config STAB_SWAP_PITCH_ROLL
        bool "Swap pitch/roll (JY61P mounted rotated 90 deg)"
        default n
        help
            Select when the JY61P is mounted 90 degrees rotated on the leg:
            pitch/roll measurement and gyro are exchanged before control.

    config STAB_PITCH_SIGN
        int "Pitch output sign (+1/-1)"
        default 1
        range -1 1
        help
            Flip to -1 if the leg pitches the wrong way under stabilization
            (forward/back direction reversed).

    config STAB_ROLL_SIGN
        int "Roll output sign (+1/-1)"
        default 1
        range -1 1
        help
            Flip to -1 if the leg rolls the wrong way under stabilization
            (left/right direction reversed).

endmenu
